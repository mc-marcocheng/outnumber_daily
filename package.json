{
  "private": true,
  "name": "outnumber",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-hooks.mjs",
    "postinstall": "patch-package --error-on-fail",
    "dev": "devvit playtest",
    "dev:local": "npm run build && tsx tools/local-preview.ts",
    "build": "vite build",
    "login": "devvit login",
    "deploy": "node scripts/require-season.mjs && npm run test:types && devvit upload",
    "test": "vitest run",
    "test:types": "tsc --build",
    "test:ui": "tsx scripts/ui-check.ts",
    "test:repo": "node --test scripts/check-repository.test.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:staged": "node scripts/check-repository.mjs",
    "check:repo": "node scripts/check-repository.mjs --all",
    "season:pool": "tsx tools/build-pool.ts",
    "season:emit": "tsx tools/emit-season.ts",
    "season:verify": "tsx tools/verify-season.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/reddit": "0.15.3",
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@hono/node-server": "2.1.11",
    "@radix-ui/react-dialog": "1.1.23",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "i18next": "26.4.2",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.13",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "patch-package": "8.0.1",
    "playwright": "1.65.1",
    "prettier": "3.9.10",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.0.0",
    "z3-solver": "^5.4.1"
  },
  "description": "Outnumber: a daily arithmetic puzzle for Reddit, built with Devvit Web.",
  "license": "BSD-3-Clause"
}
