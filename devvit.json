{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "outnumber-daily",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "game.html",
        "height": "regular"
      },
      "game": {
        "entry": "game.html"
      },
      "tutorial": {
        "entry": "tutorial.html"
      },
      "hub": {
        "entry": "hub.html",
        "height": "short",
        "styles": {
          "height": 256
        }
      },
      "intro": {
        "entry": "intro.html",
        "height": "short",
        "styles": {
          "height": 256
        }
      },
      "leaders": {
        "entry": "leaders.html",
        "height": "short"
      },
      "contribute": {
        "entry": "contribute.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "asUser": ["SUBMIT_COMMENT"]
    },
    "redis": true,
    "realtime": true,
    "http": {
      "enable": true,
      "domains": []
    }
  },
  "menu": {
    "items": [
      {
        "label": "Create community hub highlight",
        "description": "Outnumber introduction, leaderboard and puzzle contributions",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/hub-create"
      },
      {
        "label": "Create today's puzzle post",
        "description": "Outnumber daily puzzle",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      },
      {
        "label": "Create puzzle post for a date",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create-dated"
      },
      {
        "label": "Delete my Outnumber data",
        "description": "Delete your runs, scores, profile and streaks in this community",
        "location": "post",
        "postFilter": "currentApp",
        "forUserType": "user",
        "endpoint": "/internal/menu/delete-my-data"
      }
    ]
  },
  "forms": {
    "deleteMyData": "/internal/menu/delete-my-data-confirm",
    "createDatedPost": "/internal/menu/post-create-dated-confirm"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onPostDelete": "/internal/triggers/on-post-delete",
    "onCommentDelete": "/internal/triggers/on-comment-delete"
  },
  "scheduler": {
    "tasks": {
      "dailyPost": {
        "endpoint": "/internal/cron/daily-post",
        "cron": "0 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "outnumber_daily_dev"
  }
}
